modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["resend:1.0.0", "stripe:1.0.0", "github:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["gut", "zip"]

[userenv]

[userenv.shared]
ADMIN_EMAILS = "cljay_0508@hotmail.com"

[userenv.production]
QUOTE_FROM_EMAIL = "quotemate@workmatespro.com.au"
QUOTE_REPLY_TO_EMAIL = "support@workmatespro.com.au"
ADMIN_RESET_TOKEN = "77aaa8d348707bdc09b3c763bf6150f7e2006a893b0e7cfc"
